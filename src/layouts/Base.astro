---
import { SITE } from '../data/site';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { resolveTrail, normalizePath } from '../lib/hierarchy';
import {
  buildGraph,
  serializeJsonLd,
  type GraphNode,
  type WebPageType,
} from '../lib/structured-data';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Path-relative OG image, served from /public */
  ogImage?: string;
  /** Current-page label when it's a dynamic leaf (case study, article). */
  crumb?: string;
  /** WebPage subtype for the JSON-LD graph. Defaults to "WebPage". */
  pageType?: WebPageType;
  /** When true, the page's mainEntity is the Person (home, about). */
  personIsMainEntity?: boolean;
  /** Optional primary entity node for detail pages (article / creative work). */
  primaryEntity?: GraphNode | null;
}

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  ogImage = '/og.png',
  crumb,
  pageType = 'WebPage',
  personIsMainEntity = false,
  primaryEntity = null,
} = Astro.props;

// Canonical + absolute OG URL derived from `site` in astro.config.mjs.
// normalizePath drops the `.html` the `file` build format leaks in, so the
// canonical/og:url and JSON-LD @ids match the extensionless served URLs.
const cleanPath = normalizePath(Astro.url.pathname);
const canonical = new URL(cleanPath, Astro.site).href;
const ogImageUrl = new URL(ogImage, Astro.site).href;

// Hierarchical context: resolve this page's place in the site tree once, then
// inject it as a machine-readable JSON-LD @graph (WebSite → WebPage →
// BreadcrumbList → Person/primary entity). The visible breadcrumb counterpart is
// rendered by Breadcrumbs.astro inside each page's header.
const trail = resolveTrail(cleanPath, crumb);
const graph = buildGraph({
  siteUrl: SITE.url,
  pageUrl: canonical,
  title,
  description,
  trail,
  pageType,
  personIsMainEntity,
  primaryEntity,
  person: {
    name: SITE.name,
    jobTitle: SITE.tagline,
    url: SITE.url,
    email: SITE.email,
    sameAs: [SITE.social.github, SITE.social.linkedin],
    knowsAbout: [
      'Enterprise Architecture',
      'AI Security',
      'Platform Engineering',
      'Cloud Architecture',
      'DevSecOps',
      'Kubernetes',
      'Federal / DoD Systems',
    ],
    alumniOf: 'California State University, Los Angeles',
  },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.name} />
    <meta name="robots" content="index, follow" />
    <meta name="theme-color" content="#f1eee5" />
    <meta name="color-scheme" content="light" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Operating Brief type system: editorial serif + rational grotesk + evidence mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&family=Instrument+Serif:ital@0;1&family=Manrope:wght@400;600;700;800&display=swap"
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={serializeJsonLd(graph)}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script is:inline type="module" src="/scripts/site.js"></script>
  </body>
</html>
