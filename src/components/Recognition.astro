---
import { RECOGNITION } from '../data/content';
---

<section class="section section--tint" id="recognition">
  <div class="container">
    <div class="section-head" data-reveal>
      <p class="eyebrow"><span data-num="// 04"></span>Recognition</p>
      <h2>Awards, selective membership &amp; peer service.</h2>
      <p>
        The signals that travel — national awards, merit-based selection, and
        service to the field.
      </p>
    </div>

    <ul class="rec-grid" data-reveal>
      {
        RECOGNITION.map((r, i) => (
          <li class="rec card" data-reveal-child style={`--i:${i}`}>
            <div class="rec__head">
              <span class="rec__label">{r.label}</span>
              {r.year && <span class="rec__year mono">{r.year}</span>}
            </div>
            <p class="rec__detail">{r.detail}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .rec-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .rec {
    padding: 1.5rem;
  }
  .rec__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }
  .rec__label {
    font-weight: 700;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }
  .rec__year {
    font-size: 0.78rem;
    color: var(--accent);
    flex: none;
  }
  .rec__detail {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.6rem;
  }

  @media (max-width: 820px) {
    .rec-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 520px) {
    .rec-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
