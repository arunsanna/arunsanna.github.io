---
import { AWARDS } from '../data/content';
import Icon from './Icon.astro';
---

<section class="section" id="awards" data-reveal>
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow"><span data-num="// 05"></span>Awards &amp; Recognition</p>
        <h2>The record.</h2>
      </div>
      <span class="awards__count mono">{AWARDS.length} honors</span>
    </div>

    <div class="awards-grid" data-reveal>
      {
        AWARDS.map((award, i) => (
          <article class="award card" data-reveal-child style={`--i:${i}`}>
            <div class="award__head">
              <span class="award__glyph"><Icon name={award.icon} /></span>
              <div>
                <h3 class="award__title">{award.title}</h3>
                <p class="award__org mono">{award.org}</p>
              </div>
              <span class="award__year mono">{award.year}</span>
            </div>
            <p class="award__sig">{award.significance}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .awards__count {
    font-size: 0.78rem;
    color: var(--accent);
    padding: 0.25rem 0.7rem;
    border: 1px solid var(--accent-line);
    border-radius: 999px;
    background: var(--accent-ghost);
  }

  .awards-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
  .award {
    position: relative;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .award::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    border-radius: var(--radius) 0 0 var(--radius);
    opacity: 0.6;
  }
  .award__head {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }
  .award__glyph {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-sm);
    color: var(--accent);
    background: var(--accent-ghost);
    border: 1px solid var(--border);
  }
  .award__glyph svg {
    width: 1.15rem;
    height: 1.15rem;
  }
  .award__title {
    font-size: 1.05rem;
    line-height: 1.2;
    flex: 1;
  }
  .award__org {
    color: var(--accent);
    font-size: 0.72rem;
    margin-top: 0.2rem;
  }
  .award__year {
    flex: none;
    font-size: 0.8rem;
    color: var(--text-faint);
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .award__sig {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .awards-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
