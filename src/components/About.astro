---
import { Image } from 'astro:assets';
import portrait from '../../assets/Arun.png';
import { SITE } from '../data/site';
import Icon from './Icon.astro';

// Operator-format: dossier readout metrics instead of generic cards
const dossier = [
  { label: 'Years', value: '10+', icon: 'globe' },
  { label: 'Apps shipped', value: '400+', icon: 'boxes' },
  { label: 'Lives supported', value: '124K', icon: 'users' },
  { label: 'ATO cycle', value: '4 wks', icon: 'shield' },
  { label: 'Cost reduction', value: '40%', icon: 'chart' },
  { label: 'Security incidents', value: '0', icon: 'certificate' },
];
---

<section class="section section--tint" id="about" data-reveal>
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow"><span data-num="// 01"></span>About</p>
        <h2>The operator behind the systems.</h2>
      </div>
    </div>

    <div class="about__grid">
      <div class="about__dossier card" data-reveal-child>
        <div class="about__id">
          <div class="about__id-photo">
            <Image
              src={portrait}
              alt="Arun Sanna"
              widths={[200, 280, 360]}
              sizes="(max-width: 860px) 40vw, 200px"
              loading="lazy"
            />
            <span class="about__id-scan" aria-hidden="true"></span>
          </div>
          <div class="about__id-meta">
            <p class="about__id-label mono">subject</p>
            <h3 class="about__id-name">{SITE.name}</h3>
            <p class="about__id-role mono">{SITE.tagline}</p>
            <ul class="about__id-contact">
              <li><Icon name="building" /> {SITE.shippedAt[0]}</li>
              <li><Icon name="globe" /> {SITE.shippedAt[3]}</li>
              <li><Icon name="mail" /> {SITE.email}</li>
            </ul>
          </div>
        </div>

        <dl class="about__dossier-readout">
          {
            dossier.map((d) => (
              <div class="about__metric">
                <dt>
                  <span class="about__metric-glyph"><Icon name={d.icon} /></span>
                  <span class="about__metric-label mono">{d.label}</span>
                </dt>
                <dd class="about__metric-value">{d.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="about__bio" data-reveal-child style="--i:1">
        <p>
          I'm <strong>Arun Sanna</strong> — an enterprise architect who turns
          complex challenges into scalable, secure systems. From legacy
          modernization to AI-native platforms, I build for government agencies
          and frontier teams that can't afford downtime.
        </p>
        <p>
          From orchestrating platform support during Operation Allies Refuge —
          the largest evacuation in U.S. history, 124K+ lives, zero incidents —
          to modernizing healthcare systems serving millions, I've shipped where
          failure isn't an option.
        </p>
        <p>
          My focus now: <span class="text-accent">secure AI infrastructure</span>,
          agent runtimes, and the platform engineering that makes AI safe to run
          in federal and mission-critical environments.
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
    align-items: start;
  }

  /* --- Dossier card --- */
  .about__dossier {
    padding: 1.5rem;
  }
  .about__id {
    display: flex;
    gap: 1.25rem;
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.4rem;
  }
  .about__id-photo {
    position: relative;
    flex: none;
    width: clamp(110px, 30%, 150px);
    aspect-ratio: 1;
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid var(--border-strong);
  }
  .about__id-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.2) contrast(1.05);
  }
  /* CRT scanline overlay on the portrait */
  .about__id-scan {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      hsl(0 0% 0% / 0.12) 0 1px,
      transparent 1px 3px
    );
    pointer-events: none;
  }
  .about__id-meta {
    flex: 1;
    min-width: 0;
  }
  .about__id-label {
    font-size: 0.62rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-faint);
  }
  .about__id-name {
    font-size: var(--step-1);
    margin-top: 0.2rem;
  }
  .about__id-role {
    color: var(--accent);
    font-size: 0.72rem;
    margin-top: 0.35rem;
    line-height: 1.3;
  }
  .about__id-contact {
    margin-top: 0.9rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .about__id-contact li {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-faint);
    font-size: 0.76rem;
  }
  .about__id-contact svg {
    width: 0.8rem;
    height: 0.8rem;
    color: var(--accent-dim);
  }

  .about__dossier-readout {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .about__metric {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }
  .about__metric dt {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .about__metric-glyph {
    display: inline-flex;
    color: var(--accent);
  }
  .about__metric-glyph svg {
    width: 0.85rem;
    height: 0.85rem;
  }
  .about__metric-label {
    font-size: 0.64rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }
  .about__metric-value {
    font-family: var(--font-mono);
    font-size: 1.3rem;
    font-weight: 600;
    color: var(--text);
  }

  /* --- Bio text --- */
  .about__bio {
    padding-top: 0.5rem;
  }
  .about__bio p {
    color: var(--text-muted);
    font-size: 1rem;
    margin-bottom: 1.1rem;
    line-height: 1.7;
  }
  .about__bio strong {
    color: var(--text);
  }

  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__dossier-readout {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
