---
import { SITE } from '../data/site';
import Icon from './Icon.astro';
---

<section class="hero" id="top">
  <div class="container hero__inner">
    <div class="hero__copy">
      <p class="eyebrow reveal" style="--reveal-delay: 0.05s">
        <span data-num="//"></span>AI Security · Platform Engineering · Federal AI
      </p>

      <h1 class="hero__name reveal" style="--reveal-delay: 0.12s">{SITE.name}</h1>

      <p class="hero__tagline reveal" style="--reveal-delay: 0.2s">
        Enterprise <span class="text-accent">AI Architect</span> &amp; Forward Deployed Engineer
      </p>

      <p class="hero__lede reveal" style="--reveal-delay: 0.28s">{SITE.valueProp}</p>

      <div class="hero__cta reveal" style="--reveal-delay: 0.36s">
        <a href="#work" class="btn btn--primary">View Work</a>
        <a href={SITE.resume} class="btn btn--ghost" target="_blank" rel="noopener">
          <Icon name="resume" class="btn__icon" /> Download Resume
        </a>
        <div class="hero__social">
          <a href={SITE.social.github} class="hero__icon" target="_blank" rel="noopener" aria-label="GitHub">
            <Icon name="github" />
          </a>
          <a href={SITE.social.linkedin} class="hero__icon" target="_blank" rel="noopener" aria-label="LinkedIn">
            <Icon name="linkedin" />
          </a>
          <a href={`mailto:${SITE.email}`} class="hero__icon" aria-label="Email">
            <Icon name="mail" />
          </a>
        </div>
      </div>

      <dl class="hero__stats reveal" style="--reveal-delay: 0.44s">
        {
          SITE.stats.map((s) => (
            <div class="hero__stat">
              <dt class="hero__stat-value">{s.value}</dt>
              <dd class="hero__stat-label">{s.label}</dd>
            </div>
          ))
        }
      </dl>

      <div class="hero__proof reveal" style="--reveal-delay: 0.52s">
        <span class="hero__proof-label mono">Shipped at</span>
        <ul class="hero__proof-list">
          {SITE.shippedAt.map((org) => <li>{org}</li>)}
        </ul>
      </div>
    </div>

    <aside class="hero__panel reveal" style="--reveal-delay: 0.5s" aria-label="Selected impact and current focus">
      <p class="hero__panel-kicker mono">Selected impact</p>
      <ul class="hero__impact-list">
        {SITE.impactProof.map((item) => <li>{item}</li>)}
      </ul>
      <div class="hero__focus">
        <p class="hero__panel-kicker mono">Currently focused on</p>
        <ul>
          {SITE.currentFocus.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </aside>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-block: 7rem 4rem;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(18rem, 0.72fr);
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
    align-items: center;
  }
  .hero__copy {
    max-width: 56rem;
  }

  .hero__name {
    font-size: var(--step-4);
    letter-spacing: -0.04em;
    margin-top: 1.1rem;
    background: linear-gradient(180deg, var(--text), hsl(214 14% 72%));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero__tagline {
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--text);
    margin-top: 0.5rem;
    letter-spacing: -0.02em;
  }

  .hero__lede {
    font-size: var(--step-1);
    color: var(--text-muted);
    max-width: 40rem;
    margin-top: 1.5rem;
  }

  .hero__cta {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 2rem;
    flex-wrap: wrap;
  }
  .hero__social {
    display: flex;
    gap: 0.6rem;
  }
  .btn__icon {
    width: 1rem;
    height: 1rem;
  }
  .hero__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.7rem;
    height: 2.7rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text-muted);
    font-size: 1.05rem;
  }
  .hero__icon svg {
    width: 1.1rem;
    height: 1.1rem;
    transition:
      color var(--transition),
      border-color var(--transition),
      transform var(--transition);
  }
  .hero__icon:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .hero__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .hero__stat-value {
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 1.4rem + 1.6vw, 2.6rem);
    font-weight: 600;
    color: var(--accent);
    line-height: 1;
  }
  .hero__stat-label {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.5rem;
  }

  .hero__proof {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    margin-top: 2.5rem;
  }
  .hero__proof-label {
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .hero__proof-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }
  .hero__proof-list li {
    color: var(--text);
    font-size: 0.95rem;
    font-weight: 500;
    position: relative;
  }
  .hero__proof-list li + li::before {
    content: '·';
    position: absolute;
    left: -0.85rem;
    color: var(--text-faint);
  }

  .hero__panel {
    padding: clamp(1.25rem, 0.8rem + 2vw, 1.8rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background:
      linear-gradient(180deg, hsl(188 95% 55% / 0.08), transparent 38%),
      var(--surface);
    box-shadow: var(--shadow-2);
  }
  .hero__panel-kicker {
    color: var(--accent);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
  }
  .hero__impact-list,
  .hero__focus ul {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: 1rem;
  }
  .hero__impact-list li,
  .hero__focus li {
    position: relative;
    padding-left: 1.1rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }
  .hero__impact-list li::before,
  .hero__focus li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 4px var(--accent-ghost);
  }
  .hero__focus {
    margin-top: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 520px) {
    .hero__stats {
      gap: 1.5rem 2rem;
    }
  }
</style>
