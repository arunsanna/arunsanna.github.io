---
import { SITE } from '../data/site';

const principles = [
  {
    title: 'Translate complexity into a deployable path.',
    detail: 'Align mission, security, data, platform, and delivery around one operating model.',
  },
  {
    title: 'Build for scrutiny from day one.',
    detail: 'Design governance and AI security into the system—not as a launch-day attachment.',
  },
  {
    title: 'Stay close to the work.',
    detail: 'Move from whiteboard to production with the teams responsible for the result.',
  },
];
---

<section class="hero" id="top">
  <div class="container hero__brief">
    <aside class="hero__rail reveal" style="--reveal-delay: 0.04s" aria-label="Profile marker">
      <span>Built for consequential systems</span>
      <small>ET / USA</small>
    </aside>

    <div class="hero__thesis">
      <p class="eyebrow reveal" style="--reveal-delay: 0.08s">
        <span data-num="01 /"></span>Arun Sanna · Operating brief
      </p>
      <h1 class="hero__title reveal" style="--reveal-delay: 0.14s">
        The architect you call when AI has to <em>work in the real world.</em>
      </h1>
      <div class="hero__operating reveal" style="--reveal-delay: 0.22s">
        <span class="mono">Operating thesis</span>
        <p>
          I turn ambitious AI programs into secure platforms that survive procurement,
          policy, integration, and the moment real people depend on them.
        </p>
      </div>
    </div>

    <aside class="hero__principles reveal" style="--reveal-delay: 0.2s">
      <div class="hero__principles-head">
        <span class="mono">Executive practice</span>
        <p>Architecture matters most when it changes the outcome.</p>
      </div>
      <ol>
        {
          principles.map((principle, index) => (
            <li>
              <span class="mono">0{index + 1}</span>
              <div>
                <h2>{principle.title}</h2>
                <p>{principle.detail}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="hero__contact">
        <a href={`mailto:${SITE.email}`}>
          Discuss a consequential program <span aria-hidden="true">→</span>
        </a>
        <nav aria-label="Profile links">
          <a href={SITE.resume} target="_blank" rel="noopener">Résumé</a>
          <a href={SITE.social.linkedin} target="_blank" rel="noopener">LinkedIn</a>
          <a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a>
        </nav>
      </div>
    </aside>
  </div>

  <div class="container hero__ledger reveal" style="--reveal-delay: 0.3s">
    <header>
      <h2>Outcome ledger</h2>
      <p>Evidence over adjectives. Delivery over theater.</p>
      <span class="mono">Selected operating record</span>
    </header>
    <dl>
      <div>
        <dt data-count-to="10" data-suffix="+">10+</dt>
        <dd><span class="mono">Depth / years</span><strong>Enterprise systems under real constraints</strong></dd>
      </div>
      <div>
        <dt data-count-to="400" data-suffix="+">400+</dt>
        <dd><span class="mono">Scale / applications</span><strong>Platforms designed to serve portfolios</strong></dd>
      </div>
      <div>
        <dt data-count-to="124" data-suffix="K">124K</dt>
        <dd><span class="mono">Reach / lives</span><strong>Technology with human consequence</strong></dd>
      </div>
    </dl>
  </div>

  <a href="#selected-work" class="hero__scroll mono" aria-label="Continue to selected work">
    Continue to the record <span aria-hidden="true">↓</span>
  </a>
</section>

<style>
  .hero {
    padding-top: 4.5rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .hero__brief {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr) minmax(22rem, 0.52fr);
    min-height: min(68rem, calc(100svh - 4.5rem));
    border-inline: 1px solid var(--border);
  }
  .hero__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    padding-block: 2.25rem;
    border-right: 1px solid var(--border);
    color: var(--accent);
  }
  .hero__rail > span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .hero__rail small {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.1em;
    writing-mode: vertical-rl;
  }
  .hero__thesis {
    display: flex;
    flex-direction: column;
    padding: clamp(3rem, 6vw, 6.5rem) clamp(2rem, 4.5vw, 5rem) 3rem;
  }
  .hero__title {
    max-width: 11ch;
    margin-top: clamp(1.6rem, 3vw, 3rem);
    font-family: var(--font-serif);
    font-size: clamp(4.2rem, 7.15vw, 8rem);
    font-weight: 400;
    line-height: 0.91;
    letter-spacing: -0.055em;
  }
  .hero__title em {
    display: block;
    color: var(--accent);
    font-weight: 400;
  }
  .hero__operating {
    display: grid;
    grid-template-columns: 11rem minmax(0, 34rem);
    gap: 2rem;
    margin-top: auto;
    padding-top: 1.8rem;
    border-top: 1px solid var(--border);
  }
  .hero__operating > span,
  .hero__principles-head > span {
    color: var(--text-faint);
    font-size: 0.67rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .hero__operating p {
    font-size: clamp(1.15rem, 1.2vw, 1.45rem);
    font-weight: 600;
    line-height: 1.45;
  }
  .hero__principles {
    display: flex;
    flex-direction: column;
    border-left: 1px solid var(--border-strong);
    padding: clamp(2.3rem, 4vw, 4rem) clamp(1.7rem, 3vw, 3rem) 2.7rem;
  }
  .hero__principles-head {
    padding-bottom: 1.4rem;
    border-bottom: 1px solid var(--border);
  }
  .hero__principles-head p {
    max-width: 16ch;
    margin-top: 0.8rem;
    font-family: var(--font-serif);
    font-size: clamp(1.65rem, 2.3vw, 2.4rem);
    line-height: 1.05;
  }
  .hero__principles li {
    display: grid;
    grid-template-columns: 2.3rem 1fr;
    gap: 0.9rem;
    padding-block: 1.3rem;
    border-bottom: 1px solid var(--border);
  }
  .hero__principles li > span {
    color: var(--accent);
    font-size: 0.72rem;
  }
  .hero__principles h2 {
    font-size: 0.98rem;
    line-height: 1.35;
  }
  .hero__principles li p {
    margin-top: 0.35rem;
    color: var(--text-muted);
    font-size: 0.85rem;
    line-height: 1.45;
  }
  .hero__contact {
    margin-top: auto;
    padding-top: 2rem;
  }
  .hero__contact > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--text);
    padding-top: 1rem;
    font-weight: 700;
  }
  .hero__contact > a span {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--bg);
    background: var(--accent);
    border-radius: 50%;
    transition: transform var(--transition);
  }
  .hero__contact > a:hover span { transform: translateX(3px); }
  .hero__contact nav {
    display: flex;
    gap: 1rem;
    margin-top: 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.67rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .hero__contact nav a:hover { color: var(--accent); }
  .hero__ledger {
    border-inline: 1px solid var(--border);
    padding-left: calc(var(--gutter) + 5.5rem);
  }
  .hero__ledger header {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 1.5rem;
    align-items: baseline;
    padding: 1.5rem 2.5rem 1rem 0;
  }
  .hero__ledger header h2 { font-size: 1rem; }
  .hero__ledger header p {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-style: italic;
    color: var(--text-muted);
  }
  .hero__ledger header span {
    text-align: right;
    color: var(--text-faint);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero__ledger dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 0.38rem solid var(--text);
  }
  .hero__ledger dl > div {
    padding: 1.5rem 2.5rem 2rem 0;
  }
  .hero__ledger dl > div + div {
    padding-left: 2.5rem;
    border-left: 1px solid var(--border);
  }
  .hero__ledger dt {
    color: var(--accent);
    font-family: var(--font-serif);
    font-size: clamp(3.2rem, 5vw, 5rem);
    line-height: 1;
  }
  .hero__ledger dd { margin-top: 0.8rem; }
  .hero__ledger dd span {
    display: block;
    color: var(--text-faint);
    font-size: 0.64rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .hero__ledger dd strong {
    display: block;
    max-width: 19rem;
    margin-top: 0.7rem;
    font-size: 1.05rem;
    line-height: 1.3;
  }
  .hero__scroll {
    display: flex;
    justify-content: space-between;
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 0.9rem var(--gutter);
    color: var(--text-faint);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 1100px) {
    .hero__brief { grid-template-columns: 4rem 1fr 21rem; }
    .hero__rail > span { font-size: 0.58rem; }
    .hero__title { font-size: clamp(3.6rem, 7vw, 6rem); }
    .hero__operating { grid-template-columns: 1fr; gap: 0.8rem; }
    .hero__ledger { padding-left: calc(var(--gutter) + 4rem); }
  }
  @media (max-width: 820px) {
    .hero__brief { grid-template-columns: 1fr; }
    .hero__rail { display: none; }
    .hero__thesis { min-height: 44rem; }
    .hero__principles { border-left: 0; border-top: 1px solid var(--border-strong); }
    .hero__contact { margin-top: 2.5rem; }
    .hero__ledger { padding-left: var(--gutter); }
  }
  @media (max-width: 640px) {
    .hero__thesis { min-height: 38rem; padding-inline: 1.1rem; }
    .hero__title { font-size: clamp(3.3rem, 16vw, 5rem); }
    .hero__principles { padding-inline: 1.1rem; }
    .hero__ledger header { grid-template-columns: 1fr; padding-right: 0; }
    .hero__ledger header span { text-align: left; }
    .hero__ledger dl { grid-template-columns: 1fr; }
    .hero__ledger dl > div,
    .hero__ledger dl > div + div { padding: 1.3rem 0; border-left: 0; border-bottom: 1px solid var(--border); }
  }
</style>
