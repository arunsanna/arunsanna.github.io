---
import Icon from './Icon.astro';

const roles = [
  {
    company: 'Precise Software Solutions, Inc.',
    period: 'Mar 2025 — Present',
    title: 'Enterprise Solution Architect IV',
    summary:
      'Leading DevSecOps and hybrid-cloud strategy for federal agencies including FDA, CMS, HHS, and USDA.',
    bullets: [
      'Led technical proposals securing the $44M CMS Hybrid Cloud PEO contract, beating 4 competitors',
      'Own program-wide technology implementation across DevSecOps and cloud practices',
      'Design multi-discipline solution architecture and scalable, resilient cloud security services',
    ],
  },
  {
    company: 'VivSoft Technologies LLC',
    period: 'Jun 2019 — Mar 2025',
    title: 'Chief Architect',
    summary:
      "Top contributor to DoD's largest Platform-as-a-Service; drove company growth from 35 to 115 employees.",
    bullets: [
      'Won SECAF "Project of the Year" for Platform One PartyBus (2024)',
      'Secured $15.6M in federal contracts through technical leadership',
      'Led Operation Allies Refuge platform deployment supporting 120K+ lives',
      'Achieved 60% reduction in workflow turnaround via AI automation',
    ],
  },
  {
    company: 'Hitachi Vantara',
    period: '2018 — 2019',
    title: 'Sr. DevSecOps & Data Science Engineer',
    summary: 'Secure cloud infrastructure and data analytics for defense clients.',
    bullets: [
      'First DISA SCCA framework deployment on AWS GovCloud',
      'Built ML/AI infrastructure on Kubernetes for predictive analytics',
      'Led Azure migration for critical defense systems',
    ],
  },
  {
    company: 'REAN Cloud',
    period: 'Mar 2015 — Oct 2018',
    title: 'DevSecOps & Data Science Engineer',
    summary: 'Automated infrastructure provisioning, delivering 30–40% cost savings for enterprise clients.',
    bullets: [
      'Named Employee of the Year (2017)',
      'Mentored and trained 200+ engineers in DevOps',
      'Accelerated releases from infrequent manual deploys to weekly',
    ],
  },
];

const education = [
  {
    icon: 'fas fa-graduation-cap',
    degree: "Master's in Electrical Engineering",
    detail: 'Computers and Networks',
    school: 'California State University, Los Angeles',
  },
  {
    icon: 'fas fa-university',
    degree: "Bachelor's in Information Technology",
    detail: '',
    school: 'Jawaharlal Nehru Technological University',
  },
  {
    icon: 'fas fa-certificate',
    degree: 'Diploma in Electronics & Communication Engineering',
    detail: '',
    school: 'Government Polytechnic College',
  },
];

const awards = [
  { icon: 'fas fa-trophy', title: 'Project of the Year', body: 'SECAF award for Platform One PartyBus (2024)' },
  { icon: 'fas fa-star', title: 'Employee of the Year 2017', body: 'REAN Cloud — performance & innovation' },
  { icon: 'fas fa-flag-usa', title: 'Platform One Selection', body: 'Only non-US citizen selected on merit into the USAF Platform One program' },
  { icon: 'fas fa-heart', title: 'Operation Allies Refuge', body: 'Mission-critical platforms for the largest evacuation in U.S. history' },
  { icon: 'fas fa-users', title: 'Organizational Growth Leader', body: 'Drove company growth from 35 to 115 employees' },
  { icon: 'fas fa-globe', title: 'IASA Chief Architect Forum', body: 'Member of the global Chief Architect Forum' },
];
---

<section class="section" id="experience" data-reveal>
  <div class="container">
    <div class="section-head section-head--split">
      <div>
        <p class="eyebrow"><span data-num="// 02"></span>Career</p>
        <h2>Deployment log.</h2>
        <p>A decade of shipped systems — each role a release, each bullet an event worth recording.</p>
      </div>
    </div>

    <div class="xp__grid">
      <div class="xp__main" data-reveal-child>
        <div class="xp__log">
          <div class="xp__log-bar mono">
            <span class="xp__log-prompt">$</span> kubectl describe career/arun-sanna
            <span class="xp__log-live"><i></i>active</span>
          </div>
          <ol class="xp__deployments">
            {
              roles.map((r, i) => (
                <li class="xp__deploy">
                  <div class="xp__deploy-head">
                    <span class="xp__deploy-status" aria-hidden="true" />
                    <h3 class="xp__company">{r.company}</h3>
                    <span class="xp__deploy-tag mono">{r.period}</span>
                  </div>
                  <p class="xp__role mono">{r.title}</p>
                  <p class="xp__summary">{r.summary}</p                  >
                  <ul class="xp__events">
                    {r.bullets.map((b) => (
                      <li class="xp__event">
                        <span class="xp__event-marker mono" aria-hidden="true">›</span>
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                </li>
              ))
            }
          </ol>
        </div>
      </div>

      <aside class="xp__side" data-reveal-child style="--i:1">
        <div class="xp__panel">
          <p class="xp__panel-label mono">education</p>
          <ul class="xp__edu">
            {
              education.map((e) => (
                <li class="xp__edu-item">
                  <span class="xp__edu-glyph"><Icon name={e.icon} /></span>
                  <div>
                    <p class="xp__degree">{e.degree}</p>
                    {e.detail && <p class="xp__edu-detail">{e.detail}</p>}
                    <p class="xp__school mono">{e.school}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="xp__panel">
          <p class="xp__panel-label mono">awards &amp; recognition</p>
          <ul class="xp__awards">
            {
              awards.map((a) => (
                <li class="xp__award">
                  <span class="xp__award-glyph"><Icon name={a.icon} /></span>
                  <div>
                    <p class="xp__award-title">{a.title}</p>
                    <p class="xp__award-body">{a.body}</p>
                  </div>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>
  </div>
</section>

<style>
  .xp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
    align-items: start;
  }

  /* --- Deployment log (main column) --- */
  .xp__log {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--grad-surface);
    overflow: hidden;
  }
  .xp__log-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface-2);
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .xp__log-prompt {
    color: var(--accent);
  }
  .xp__log-live {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.7rem;
    color: var(--accent-strong);
  }
  .xp__log-live i {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--accent);
    animation: xp-pulse 2s var(--ease-out) infinite;
  }
  @keyframes xp-pulse {
    0% { box-shadow: 0 0 0 0 hsl(146 72% 50% / 0.5); }
    70% { box-shadow: 0 0 0 5px hsl(146 72% 50% / 0); }
    100% { box-shadow: 0 0 0 0 hsl(146 72% 50% / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .xp__log-live i { animation: none; }
  }

  .xp__deployments {
    padding: 0;
  }
  .xp__deploy {
    padding: 1.4rem 1.4rem 1.6rem;
    border-bottom: 1px solid var(--border);
  }
  .xp__deploy:last-child {
    border-bottom: 0;
  }
  .xp__deploy-head {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }
  .xp__deploy-status {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-ghost);
    flex: none;
  }
  .xp__company {
    font-size: 1.12rem;
    flex: 1;
  }
  .xp__deploy-tag {
    font-size: 0.72rem;
    color: var(--text-faint);
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    white-space: nowrap;
  }
  .xp__role {
    color: var(--accent);
    font-size: 0.82rem;
    margin-top: 0.4rem;
    padding-left: 1.15rem;
  }
  .xp__summary {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.6rem;
    padding-left: 1.15rem;
  }
  .xp__events {
    margin-top: 0.8rem;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .xp__event {
    display: flex;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 0.84rem;
    line-height: 1.5;
  }
  .xp__event-marker {
    color: var(--accent-dim);
    flex: none;
  }

  /* --- Side panels --- */
  .xp__side {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .xp__panel {
    padding: 1.4rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .xp__panel-label {
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-faint);
    margin-bottom: 1.1rem;
    padding-bottom: 0.8rem;
    border-bottom: 1px solid var(--border);
  }
  .xp__edu,
  .xp__awards {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .xp__edu-item,
  .xp__award {
    display: flex;
    gap: 0.75rem;
  }
  .xp__edu-glyph,
  .xp__award-glyph {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border-radius: var(--radius-sm);
    color: var(--accent);
    background: var(--accent-ghost);
    border: 1px solid var(--border);
  }
  .xp__edu-glyph svg,
  .xp__award-glyph svg {
    width: 1rem;
    height: 1rem;
  }
  .xp__degree,
  .xp__award-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }
  .xp__edu-detail {
    color: var(--text-muted);
    font-size: 0.8rem;
  }
  .xp__school,
  .xp__award-body {
    color: var(--text-faint);
    font-size: 0.78rem;
    margin-top: 0.15rem;
  }

  @media (max-width: 860px) {
    .xp__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
