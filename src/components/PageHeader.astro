---
import Breadcrumbs from './Breadcrumbs.astro';

interface Props {
  num: string;
  eyebrow: string;
  title: string;
  lede?: string;
}
const { num, eyebrow, title, lede } = Astro.props;
---

<header class="page-head">
  <div class="container">
    <Breadcrumbs />
    <p class="eyebrow"><span data-num={num}></span>{eyebrow}</p>
    <h1 class="page-head__title">{title}</h1>
    {lede && <p class="page-head__lede">{lede}</p>}
  </div>
</header>

<style>
  .page-head {
    padding-top: clamp(7rem, 5rem + 6vw, 9.5rem);
    padding-bottom: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }
  .page-head__title {
    font-size: var(--step-4);
    margin-top: 0.8rem;
    max-width: 18ch;
  }
  .page-head__lede {
    color: var(--text-muted);
    font-size: var(--step-1);
    margin-top: 1.1rem;
    max-width: 56ch;
  }
</style>
