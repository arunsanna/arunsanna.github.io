---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { SITE } from '../../data/site';
import { POSTS, type Post } from '../../data/content';
import { buildArticle } from '../../lib/structured-data';
import { normalizePath } from '../../lib/hierarchy';

// Long-form bodies live as markdown under src/content/writing/<slug>.md.
// Posts without a body file keep their "draft in progress" placeholder.
const bodies = import.meta.glob<{ Content: any }>('../../content/writing/*.md', {
  eager: true,
});

export function getStaticPaths() {
  return POSTS.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const bodyEntry = Object.entries(bodies).find(([path]) =>
  path.includes(post.slug)
);
const Body = bodyEntry?.[1]?.Content;
const fmt = (d: string) =>
  new Date(d + 'T00:00:00').toLocaleDateString('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
  });

// This post is the page's primary entity — a BlogPosting linked into the JSON-LD
// graph and authored by the site's Person.
const pageUrl = new URL(normalizePath(Astro.url.pathname), Astro.site).href;
const article = buildArticle(SITE.url, {
  url: pageUrl,
  title: post.title,
  description: post.summary,
  datePublished: post.date,
  keywords: post.tags,
});
---

<Base
  title={`${post.title}${["pdf-conversion-evidence-survival", "permission-laundering-original-grant"].includes(post.slug) ? " | " : " — "}Arun Sanna`}
  description={post.summary}
  pageType="ItemPage"
  crumb={post.title}
  primaryEntity={article}
>
  <article class="container article">
    <Breadcrumbs leafLabel={post.title} />

    <div class="article__meta">
      {post.tags.map((t) => <span class="tag">{t}</span>)}
      <span class="mono">{fmt(post.date)} · {post.readingTime}</span>
    </div>

    <h1 class="article__title">{post.title}</h1>
    <p class="article__lede">{post.summary}</p>

    {Body ? (
      <div class="article__body">
        <Body />
      </div>
    ) : (
      <div class="article__note">
        <p class="mono article__note-label">draft in progress</p>
        <p>
          The long-form is being written from the research and the systems behind
          this thesis — published here when it's ready, never auto-generated.
        </p>
        <a href={`mailto:${SITE.email}`} class="arrow-link">
          Want it early? Ping me <Icon name="arrow" />
        </a>
      </div>
    )}
  </article>
</Base>

<style>
  .article {
    max-width: var(--maxw-prose);
    padding-top: clamp(7rem, 5rem + 6vw, 9.5rem);
    padding-bottom: 5rem;
  }
  .article__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.75rem;
    color: var(--text-faint);
    font-size: 0.8rem;
  }
  .article__title {
    font-size: var(--step-3);
    margin-top: 1rem;
  }
  .article__lede {
    font-size: var(--step-1);
    color: var(--text-muted);
    margin-top: 1.25rem;
  }
  .article__note {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--surface);
  }
  .article__note-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    margin-bottom: 0.6rem;
  }
  .article__note p {
    color: var(--text-muted);
  }
  .article__note .arrow-link {
    margin-top: 1rem;
  }

  .article__body { margin-top: 2.5rem; font-size: 1.0625rem; line-height: 1.8; overflow-wrap: anywhere; }
  .article__body :global(p), .article__body :global(ul), .article__body :global(ol) { margin: 1.25rem 0; }
  .article__body :global(h2) { margin: 3rem 0 1rem; font-size: var(--step-1); line-height: 1.3; }
  .article__body :global(img) { display: block; width: 100%; height: auto; margin: 2rem 0 0.75rem; border-radius: var(--radius-sm); }
  .article__body :global(p:has(img) + p) { color: var(--text-muted); font-size: 0.875rem; line-height: 1.6; margin-top: 0; }
  .article__body :global(table) { width: 100%; border-collapse: collapse; margin: 1.75rem 0; font-size: 0.875rem; line-height: 1.6; table-layout: fixed; }
  .article__body :global(th), .article__body :global(td) { border: 1px solid var(--border); padding: 0.75rem; vertical-align: top; overflow-wrap: anywhere; }
  .article__body :global(th) { background: var(--surface); text-align: left; }
  .article__body :global(code) { font-size: 0.9em; overflow-wrap: anywhere; }
  .article__body :global(a) { text-decoration: underline; text-underline-offset: 0.2em; }
  @media (max-width: 600px) {
    .article__body { font-size: 1rem; }
    .article__body :global(th), .article__body :global(td) { padding: 0.5rem; }
    .article__body :global(table) { font-size: 0.8rem; }
  }
</style>
