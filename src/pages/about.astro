---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Certifications from '../components/Certifications.astro';
import Awards from '../components/Awards.astro';
---

<Base
  title="About — Arun Sanna"
  description="Enterprise AI Architect & Forward Deployed Engineer — bio, career deployment log, stack inventory, verified certifications, and awards."
>
  <PageHeader
    num="// about"
    eyebrow="About"
    title="Architect. Operator. AI security practitioner."
    lede="Ten years across defense, federal healthcare, and frontier AI — building secure platforms where failure isn't an option."
  />
  <About />
  <hr class="seam" />
  <Experience />
  <Skills />
  <Certifications />
  <Awards />
</Base>
