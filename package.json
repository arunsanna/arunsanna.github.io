{
  "name": "arunsanna-site",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Arun Sanna portfolio — Astro static build served by Fastify on ArunLabs Forge k3s.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "NODE_ENV=production node server.mjs",
    "serve": "NODE_ENV=production node server.mjs",
    "check": "astro check && node --check server.mjs",
    "test": "node --test \"test/**/*.test.ts\"",
    "gen:assets": "node scripts/gen-assets.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/static": "^9.1.3",
    "fastify": "^5.8.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "astro": "^5.18.2",
    "sharp": "^0.34.4",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
